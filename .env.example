# =====================================================================
# منصة التوظيف الذكية — إعدادات متغيرات البيئة (Production .env)
# تنبيه أمني: لا تقم برفع ملف .env إلى GitHub ولا تخزن أي مفاتيح في المتصفح
# =====================================================================

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# رابط الاتصال بقاعدة بيانات PostgreSQL (إلزامي في الإنتاج)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_hr_db

# تهيئة الجداول والبيانات الافتراضية تلقائياً عند أول تشغيل
AUTO_SEED_DB=true

# مفاتيح مزودي الذكاء الاصطناعي (اختياري — تُدار حصرياً على الخادم)
# في حال عدم ضبط مفتاح خارجي، يعمل محرك التقييم الدلالي المدمج (Smart Rubric Engine) تلقائياً
AI_DEFAULT_PROVIDER=smart-rubric
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# إعدادات الحماية والرفع
MAX_UPLOAD_MB=10
ADMIN_ACCESS_CODE=RUWAA-HR-2026
