# =====================================================================
# منصة التوظيف الذكية v2.0 — إعدادات متغيرات البيئة (Production .env)
# تنبيه أمني: لا تقم برفع ملف .env إلى GitHub ولا تخزن أي مفاتيح في المتصفح
# =====================================================================

PORT=3000
HOST=0.0.0.0
BIND_IP=0.0.0.0
NODE_ENV=production

# رابط الاتصال بقاعدة بيانات PostgreSQL (إلزامي في الإنتاج)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_hr_db

# تهيئة الجداول والبيانات الافتراضية تلقائياً عند أول تشغيل
AUTO_SEED_DB=true

# إعدادات موديلات Ollama المحلية على خادمك (بدون رسوم أو مفاتيح خارجية)
AI_DEFAULT_PROVIDER=smart-rubric
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# مفاتيح مزودي الذكاء الاصطناعي السحابية (اختيارية)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# إعدادات الحماية، الصلاحيات (RBAC)، وكلمة مرور المدير العام المبدئية (admin)
MAX_UPLOAD_MB=10
ADMIN_ACCESS_CODE=RUWAA-HR-2026
SESSION_SECRET=

# =====================================================================
# v2.3 — بوابة رسائل واتساب التشغيلية عبر WAHA (Dry-Run إلزامي)
# لا تضع أي مفتاح حقيقي في هذا الملف ولا في Git؛ Hermes يضبط القيم على الخادم مباشرة.
# =====================================================================
WAHA_BASE_URL=http://waha-bbg7-waha-1:3000
WAHA_SESSION=default
# قفل الأمان: يبقى true حتى اعتماد المالك الصريح؛ تغييره إلى false لا يكفي وحده (يلزم WAHA_LIVE_APPROVED=true)
WAHA_DRY_RUN=true
WAHA_LIVE_APPROVED=false
# اسم شبكة Docker الحاوية WAHA للربط الداخلي (waha-bbg7_default)
WAHA_DOCKER_NETWORK=waha-bbg7_default
# يضبطهما Hermes على الخادم فقط (لا تُكتب قيمهما هنا)
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
